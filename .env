# ===========================================
# CamperSites Pro - Variables de Entorno
# YRYS - Configuración Gratuita (sin API keys requeridas)
# ===========================================

# Supabase - Usamos endpoint público de demostración o deja vacío para modo offline
SUPABASE_URL=https://demo.supabase.co
SUPABASE_ANON_KEY=demo_key

# Mapbox - NO necesario, usamos OpenStreetMap gratuito
MAPBOX_ACCESS_TOKEN=pk.demo
