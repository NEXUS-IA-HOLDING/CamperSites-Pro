# ===========================================
# CamperSites Pro - Variables de Entorno
# YRYS - Configuración para Desarrollo
# ===========================================
# IMPORTANTE: Este archivo NO debe commitearse al repositorio
# Usa .env.example como plantilla y configura tus propias credenciales

# -------------------------------------------
# SUPABASE - Base de datos y autenticación
# -------------------------------------------
# Obtén estas credenciales en: https://app.supabase.com/project/_/settings/api
# La app funcionará sin ellas (modo offline), pero no tendrá datos sincronizados

SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-aqui

# -------------------------------------------
# MAPBOX - Mapas y navegación (OPCIONAL)
# -------------------------------------------
# Si no lo usas, la app usará OpenStreetMap por defecto
# Obtén tu token gratis en: https://account.mapbox.com/

MAPBOX_ACCESS_TOKEN=pk.demo

# -------------------------------------------
# OPEN STREET VIEW - Imágenes 360° (OPCIONAL)
# -------------------------------------------
# Si no lo usas, esta feature estará desactivada
# Obtén tu API key en: https://www.openstreetview.org/

OPEN_STREET_VIEW_KEY=tu-api-key-aqui
