# CamperSites Pro — plantilla de entorno
# 1. Copia este archivo:  cp .env.example .env
# 2. Rellena SOLO en .env (local, no se sube a Git)
# 3. Nunca pongas secretos reales en este archivo

# --- Supabase (Dashboard → Project Settings → API) ---
# URL pública y clave "anon" (public). NUNCA uses service_role aquí.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Mapbox (opcional; vacío = OpenStreetMap) ---
MAPBOX_ACCESS_TOKEN=

# --- OpenStreetView (opcional) ---
OPEN_STREET_VIEW_KEY=

# --- Admin (hashes, nunca el código en claro) ---
# Genera hashes en local: npm run generate-admin-hash -- TU_CODIGO
# Dejar vacío desactiva el modo admin.
ADMIN_MASTER_HASH=
ADMIN_TEST_HASH=
ADMIN_SUPPORT_HASH=
ADMIN_SALT=
