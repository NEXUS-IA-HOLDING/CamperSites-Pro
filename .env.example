# Supabase - https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Mapbox - NO necesario, usamos OpenStreetMap gratuito
# Si quieres usar Mapbox: https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=pk.demo
