# ===========================================
# CamperSites Pro - Variables de Entorno
# YRYS - Configuración para Producción
# ===========================================
# IMPORTANTE: Este archivo es SOLO para desarrolladores.
# El usuario final NO necesita configurar estas variables.
# Las claves ya están preconfiguradas en la app compilada.

# Supabase - https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Mapbox - Token gestionado por la empresa
EXPO_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoiY2FtcGVyc2l0ZXMtcHJvIiwiYSI6ImNscXh5ejB3YTA...

# OpenStreetView - API Key gestionada por la empresa
EXPO_PUBLIC_OPEN_STREET_VIEW_KEY=your_api_key_here

# API Backend
EXPO_PUBLIC_API_URL=https://api.campersitespro.com
