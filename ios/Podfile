require_relative '../node_modules/react-native/scripts/react_native_pods'
require_relative '../node_modules/@react-native-community/cli-platform-ios/native_modules'
require_relative '../node_modules/react-native-permissions/scripts/setup'

platform :ios, '14.0'
install! 'cocoapods', :deterministic_uuids => false

target 'CamperSitesTemp' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => true,
  )

  # react-native-permissions: setup de permisos necesarios
  setup_permissions([
    'LocationWhenInUse',
    'LocationAlways',
    'Notifications',
  ])

  post_install do |installer|
    react_native_post_install(
      installer,
      :mac_catalyst_enabled => false
    )
    $RNMapboxMaps.post_install(installer)
    
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings.delete('BUILD_LIBRARY_FOR_DISTRIBUTION')

        # Ensure minimum deployment target of 14.0 for all pods
        current = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if current.to_f < 14.0
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '14.0'
        end

        # Fix para Swift
        config.build_settings['LIBRARY_SEARCH_PATHS'] ||= ['$(inherited)']
        config.build_settings['LIBRARY_SEARCH_PATHS'] << '"$(TOOLCHAIN_DIR)/usr/lib/swift/$(PLATFORM_NAME)"'
        config.build_settings['LIBRARY_SEARCH_PATHS'] << '"$(SDKROOT)/usr/lib/swift"'
      end

      # Fix RNScreens missing header search paths for legacy architecture
      if target.name == 'RNScreens'
        target.build_configurations.each do |config|
          config.build_settings['HEADER_SEARCH_PATHS'] ||= ['$(inherited)']
          config.build_settings['HEADER_SEARCH_PATHS'] << '"$(PODS_TARGET_SRCROOT)/ios/utils"'
        end
      end
    end
  end
end
