    "upload": "node scripts/setup-database.js",
    "check-migration": "node scripts/check-migration.js",
    "typecheck": "tsc --noEmit",
    "build:playstore": "bash scripts/build-playstore-bundle.sh",
    "build:bundle": "cd android && ./gradlew bundleRelease",
    "build:apk-debug": "cd android && ./gradlew assembleDebug",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "cd ios && xcodebuild -workspace CamperSitesTemp.xcworkspace -scheme CamperSitesTemp -configuration Release",
    "generate-admin-hash": "node scripts/generate-admin-hash.js"
  },
