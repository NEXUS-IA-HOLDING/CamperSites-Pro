{
  "name": "camper-sites-pro",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest --no-watchman",
    "lint": "eslint .",
    "setup": "./setup.sh",
    "setup-database": "node scripts/setup-database.js",
    "scrape": "node scripts/scrape-data.js",
    "scrape:europe": "node scripts/scrape-europe-full.js",
